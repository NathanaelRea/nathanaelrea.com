---
import Layout from "../layouts/Layout.astro";
import ImageContainer from "../layouts/ImageContainer.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import i3 from "../assets/Photos/2024-01-19.1.jpg";
import i4 from "../assets/Photos/2024-01-19.2.jpg";
import i6 from "../assets/Photos/2024-01-20.2.jpg";
import tahoe from "../assets/Photos/2024-07-28_tahoe.jpg";
import haarlem from "../assets/Photos/2024-08-30_haarlem.jpg";
import ams from "../assets/Photos/2024-09-02_ams.jpg";
import park1 from "../assets/Photos/2024-12-07_park1.jpg";
import park2 from "../assets/Photos/2024-12-07_park2.jpg";
import pit_pycon from "../assets/Photos/PXL_20240516_150544571.RAW-01.COVER.jpg";
import philadelphiaNight from "../assets/Photos/PXL_20241229_063945475.RAW-01.MP.COVER.jpg";
import philadelphia from "../assets/Photos/PXL_20250118_211311260.RAW-01.MP.COVER.jpg";
import amsterdamNight from "../assets/Photos/PXL_20250822_213740741.MP.jpg";
import goldenGateHeights from "../assets/Photos/PXL_20250912_223053686.MP.jpg";
import bayBridge from "../assets/Photos/PXL_20251027_043632935.MP.jpg";
import paintedLadies from "../assets/Photos/PXL_20251111_013557791.jpg";
import sanFranciscoSunset from "../assets/Photos/PXL_20260328_022815760.MP.jpg";
import goldenGateSailboats from "../assets/Photos/PXL_20260517_193638629.MP.jpg";
import goldenGateView from "../assets/Photos/PXL_20260517_204931865.MP.jpg";
---

<Layout title="Photos">
  <ImageContainer>
    <OptimizedImage
      src={goldenGateView}
      alt="san francisco from the golden gate bridge"
    />
    <OptimizedImage
      src={goldenGateSailboats}
      alt="sailboats by the golden gate bridge"
    />
    <OptimizedImage src={sanFranciscoSunset} alt="top of mark" />
    <OptimizedImage src={paintedLadies} alt="painted ladies at dusk" />
    <OptimizedImage src={bayBridge} alt="under the bay bridge" />
    <OptimizedImage
      src={goldenGateHeights}
      alt="golden gate from laurel heights"
    />
    <OptimizedImage src={amsterdamNight} alt="amsterdam canal at night" />
    <OptimizedImage
      src={philadelphia}
      alt="philadelphia from the museum of art"
    />
    <OptimizedImage
      src={philadelphiaNight}
      alt="philadelphia city hall at night"
    />
    <OptimizedImage src={park2} alt="central park ski" />
    <OptimizedImage src={park1} alt="central park south" />
    <OptimizedImage src={ams} alt="amsterdam" />
    <OptimizedImage src={haarlem} alt="haarlem" />
    <OptimizedImage src={tahoe} alt="tahoe" />
    <OptimizedImage src={pit_pycon} alt="pittsburgh sisters, pycon" />
    <OptimizedImage src={i6} alt="point state park" />
    <OptimizedImage src={i4} alt="pittsburgh winter sisters" />
    <OptimizedImage src={i3} alt="pittsburgh 2024-01-19" />
  </ImageContainer>
</Layout>
